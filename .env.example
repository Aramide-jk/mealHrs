# MealHrs Platform Environment Configuration
# Use this template for local development and deployment environments.

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mealhrs

# Backend API Service
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Paystack Payment Gateway (Use test credentials for development)
PAYSTACK_SECRET_KEY=sk_test_placeholder_key_for_development
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_placeholder_key_for_development

# Web Frontend Integration
NEXT_PUBLIC_USE_HTTP_API=false
API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
